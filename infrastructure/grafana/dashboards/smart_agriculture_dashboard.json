          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/Trạng thái bơm/",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "postgresql"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH latest_soil AS (\n  SELECT value, measurement_time\n  FROM ingested_events\n  WHERE sensor_id = 'SEN-003' AND processing_status = 'STORED'\n  ORDER BY measurement_time DESC\n  LIMIT 1\n)\nSELECT\n  CASE\n    WHEN value IS NULL THEN 'OFF (NGỪNG TƯỚI)'\n    WHEN value < 30.0 THEN 'ON (ĐANG TƯỚI)'\n    WHEN value > 35.0 THEN 'OFF (NGỪNG TƯỚI)'\n    ELSE 'HOLD (DUY TRÌ)'\n  END AS \"Trạng thái bơm\"\nFROM (\n  SELECT (SELECT value FROM latest_soil) AS value\n) t;",
          "refId": "A"
        }
      ]
    },
