    {
      "id": 6,
      "title": "Sensor Status (Trạng thái cảm biến)",
      "type": "table",
      "datasource": {
        "type": "postgres",
        "uid": "postgresql"
      },
      "gridPos": {
        "h": 7,
        "w": 10,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false
          },
          "mappings": []
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Trạng thái"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "ONLINE": {
                        "color": "green",
                        "index": 0
                      },
                      "STALE": {
                        "color": "orange",
                        "index": 1
                      },
                      "OFFLINE": {
                        "color": "red",
                        "index": 2
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "cellHeight": "sm",
        "footer": {
          "countRows": false,
          "fields": "",
          "reducer": [
            "sum"
          ],
          "show": false
        },
        "showHeader": true
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "postgresql"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH registry AS (\n  SELECT 'SEN-001' AS sensor_id, 'Temperature' AS sensor_name, '°C' AS unit\n  UNION ALL SELECT 'SEN-002', 'Air Humidity', '%'\n  UNION ALL SELECT 'SEN-003', 'Soil Moisture', '%'\n),\nlatest AS (\n  SELECT DISTINCT ON (sensor_id)\n    sensor_id,\n    measurement_time,\n    received_at,\n    value\n  FROM ingested_events\n  WHERE processing_status = 'STORED'\n  ORDER BY sensor_id, measurement_time DESC\n)\nSELECT\n  r.sensor_id AS \"Mã cảm biến\",\n  r.sensor_name AS \"Tên cảm biến\",\n  COALESCE(ROUND(l.value::numeric, 1)::text || ' ' || r.unit, 'Chưa có') AS \"Giá trị mới nhất\",\n  COALESCE(to_char(l.measurement_time AT TIME ZONE 'UTC', 'YYYY-MM-DD HH24:MI:SS'), 'Chưa có') AS \"Thời điểm đo (UTC)\",\n  CASE\n    WHEN l.received_at IS NULL THEN 'OFFLINE'\n    WHEN NOW() - l.received_at < INTERVAL '30 seconds' THEN 'ONLINE'\n    WHEN NOW() - l.received_at < INTERVAL '60 seconds' THEN 'STALE'\n    ELSE 'OFFLINE'\n  END AS \"Trạng thái\"\nFROM registry r\nLEFT JOIN latest l ON r.sensor_id = l.sensor_id\nORDER BY r.sensor_id;",
          "refId": "A"
        }
      ]
    },
    {
